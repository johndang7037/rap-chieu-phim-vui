<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CineStar - Quản Lý & Đặt Vé Rạp Chiếu Phim</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .seat { transition: all 0.2s ease; cursor: pointer; user-select: none; }
    .seat:hover:not(.occupied) { transform: scale(1.15); }
    .seat-selected { background-color: #10b981 !important; color: #ffffff !important; font-weight: bold; }
    .seat-occupied { background-color: #1e293b !important; color: #475569 !important; border: 1px solid #334155; cursor: not-allowed !important; opacity: 0.45; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">

  <!-- Navbar -->
  <nav class="bg-slate-900/90 backdrop-blur sticky top-0 z-50 border-b border-slate-800 px-6 py-4 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <i class="fa-solid fa-film text-red-500 text-2xl"></i>
      <span class="text-xl font-bold tracking-wider text-red-500 uppercase">CineStar</span>
    </div>
    <div class="flex space-x-3">
      <button onclick="switchTab('booking')" class="px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-sm font-semibold transition">
        <i class="fa-solid fa-ticket mr-1.5"></i> Đặt Vé Khách Hàng
      </button>
      <button onclick="switchTab('admin')" class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-sm font-semibold transition border border-slate-700">
        <i class="fa-solid fa-chart-line mr-1.5"></i> Quản Trị Viên (Admin)
      </button>
    </div>
  </nav>

  <!-- Giao diện Khách Hàng (Booking) -->
  <main id="bookingSection" class="flex-1 max-w-5xl w-full mx-auto p-4 md:p-6 space-y-6">
    <!-- Bộ chọn phim & suất chiếu -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-slate-900 p-5 rounded-2xl border border-slate-800 shadow-xl">
      <div>
        <label class="block text-xs uppercase text-slate-400 mb-1.5 font-bold">1. Chọn Phim</label>
        <select id="movieSelect" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2.5 text-sm focus:outline-none focus:border-red-500 text-white">
          <option value="100000" data-title="Mai (Trấn Thành)">Mai (100.000 VNĐ)</option>
          <option value="120000" data-title="Dune: Hành Tinh Cát 2">Dune: Hành Tinh Cát 2 (120.000 VNĐ)</option>
          <option value="90000" data-title="Kung Fu Panda 4">Kung Fu Panda 4 (90.000 VNĐ)</option>
          <option value="110000" data-title="Godzilla x Kong">Godzilla x Kong (110.000 VNĐ)</option>
        </select>
      </div>
      <div>
        <label class="block text-xs uppercase text-slate-400 mb-1.5 font-bold">2. Chọn Suất Chiếu</label>
        <select id="showtimeSelect" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2.5 text-sm focus:outline-none text-white">
          <option>14:30 - Rạp 01 (2D Phụ đề)</option>
          <option>17:00 - Rạp 02 (2D Lồng tiếng)</option>
          <option>19:45 - Rạp 01 (IMAX 2D)</option>
          <option>21:30 - Rạp 03 (2D Phụ đề)</option>
        </select>
      </div>
      <div class="flex flex-col justify-end">
        <div class="bg-slate-800 p-3 rounded-lg border border-slate-700 flex items-center justify-between">
          <span class="text-sm text-slate-300">Đã chọn: <b id="count" class="text-emerald-400 text-base">0</b> ghế</span>
          <span class="text-base font-bold text-red-400" id="total">0 VNĐ</span>
        </div>
      </div>
    </div>

    <!-- Sơ đồ rạp chiếu -->
    <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 shadow-xl flex flex-col items-center">
      <div class="w-4/5 h-2.5 bg-gradient-to-r from-red-600 via-red-500 to-red-600 rounded-full shadow-[0_0_25px_rgba(239,68,68,0.7)] mb-2"></div>
      <p class="text-xs text-slate-400 mb-8 font-semibold tracking-widest uppercase">Màn Hình Chiếu</p>

      <!-- Vùng chứa các ô ghế -->
      <div id="seatContainer" class="grid grid-cols-8 gap-3 sm:gap-4 mb-8"></div>

      <!-- Chú thích ghế -->
      <div class="flex flex-wrap gap-6 text-xs text-slate-400 justify-center border-t border-slate-800/80 pt-4 w-full">
        <div class="flex items-center gap-2"><div class="w-5 h-5 rounded bg-slate-700"></div> Ghế thường (Bấm để chọn)</div>
        <div class="flex items-center gap-2"><div class="w-5 h-5 rounded bg-emerald-500"></div> Đang chọn</div>
        <div class="flex items-center gap-2"><div class="w-5 h-5 rounded bg-slate-900 border border-slate-700 opacity-40"></div> Đã bán</div>
      </div>
    </div>

    <!-- Nút Đặt Vé -->
    <div class="text-center pb-6">
      <button onclick="openCheckoutModal()" class="px-8 py-3.5 rounded-xl bg-red-600 hover:bg-red-700 font-bold text-base shadow-lg shadow-red-600/30 transition active:scale-95">
        <i class="fa-solid fa-credit-card mr-2"></i> Xác Nhận Đặt Vé & Thanh Toán
      </button>
    </div>
  </main>

  <!-- Trang Quản Trị (Admin) -->
  <main id="adminSection" class="hidden flex-1 max-w-5xl w-full mx-auto p-4 md:p-6 space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800">
        <p class="text-slate-400 text-sm">Tổng Vé Đã Bán</p>
        <h3 id="adminTickets" class="text-3xl font-bold mt-2 text-emerald-400">0</h3>
      </div>
      <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800">
        <p class="text-slate-400 text-sm">Tổng Doanh Thu</p>
        <h3 id="adminRevenue" class="text-3xl font-bold mt-2 text-red-400">0 VNĐ</h3>
      </div>
      <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800">
        <p class="text-slate-400 text-sm">Tổng Số Phim</p>
        <h3 class="text-3xl font-bold mt-2 text-blue-400">4</h3>
      </div>
    </div>

    <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-bold">Lịch Sử Đặt Vé Gần Đây</h2>
        <button onclick="clearAllData()" class="text-xs bg-red-950 text-red-400 border border-red-800 px-3 py-1.5 rounded-lg hover:bg-red-900">
          Xóa Lịch Sử
        </button>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-800 text-slate-400 text-xs uppercase">
            <tr>
              <th class="p-3">Mã Vé</th>
              <th class="p-3">Khách Hàng</th>
              <th class="p-3">SĐT</th>
              <th class="p-3">Phim</th>
              <th class="p-3">Ghế Chọn</th>
              <th class="p-3">Tổng Tiền</th>
            </tr>
          </thead>
          <tbody id="adminTableBody" class="divide-y divide-slate-800"></tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- Modal Đặt Vé Hoàn Tất -->
  <div id="checkoutModal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4">
      <h3 class="text-lg font-bold text-slate-100 flex items-center gap-2">
        <i class="fa-solid fa-circle-check text-emerald-400"></i> Xác Nhận Thông Tin Đặt Vé
      </h3>
      <div class="space-y-3">
        <div>
          <label class="block text-xs text-slate-400 mb-1 font-semibold">Họ tên người nhận vé:</label>
          <input id="custName" type="text" value="Nguyễn Văn A" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2.5 text-sm focus:outline-none focus:border-red-500 text-white">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1 font-semibold">Số điện thoại:</label>
          <input id="custPhone" type="text" value="0912345678" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2.5 text-sm focus:outline-none focus:border-red-500 text-white">
        </div>
      </div>
      <div class="p-3.5 bg-slate-800/80 rounded-xl text-sm space-y-1.5 border border-slate-700">
        <div class="flex justify-between text-xs text-slate-400"><span>Phim:</span> <span id="modalMovie" class="text-slate-200 font-semibold"></span></div>
        <div class="flex justify-between text-xs text-slate-400"><span>Suất chiếu:</span> <span id="modalShowtime" class="text-slate-200"></span></div>
        <div class="flex justify-between text-xs text-slate-400"><span>Vị trí ghế:</span> <span id="modalSeats" class="text-emerald-400 font-bold"></span></div>
        <div class="flex justify-between text-sm pt-2 border-t border-slate-700 font-bold">
          <span>Tổng tiền:</span> <span id="modalTotal" class="text-red-400"></span>
        </div>
      </div>
      <div class="flex justify-end gap-3 pt-2">
        <button onclick="closeCheckoutModal()" class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-sm">Hủy</button>
        <button onclick="confirmBooking()" class="px-5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-sm font-bold text-white shadow-lg shadow-emerald-600/30">
          Hoàn Tất Đặt Vé
        </button>
      </div>
    </div>
  </div>

  <script>
    const ROWS = 6;
    const COLS = 8;
    let selectedSeatIndices = [];
    const occupiedSeats = [3, 11, 20, 27, 36]; // Một vài ghế mẫu đã bán

    // Khởi tạo sơ đồ ghế
    function initSeatMap() {
      const container = document.getElementById('seatContainer');
      if (!container) return;
      container.innerHTML = '';
      selectedSeatIndices = [];
      updateTotals();

      for (let i = 0; i < ROWS * COLS; i++) {
        const rowChar = String.fromCharCode(65 + Math.floor(i / COLS));
        const colNum = (i % COLS) + 1;
        const seatName = `${rowChar}${colNum}`;

        const seat = document.createElement('div');
        seat.innerText = seatName;

        if (occupiedSeats.includes(i)) {
          seat.className = 'w-9 h-9 rounded-lg flex items-center justify-center text-xs font-semibold seat seat-occupied';
        } else {
          seat.className = 'w-9 h-9 rounded-lg flex items-center justify-center text-xs font-semibold seat bg-slate-700 hover:bg-slate-600 text-slate-200';
          seat.onclick = function() {
            if (selectedSeatIndices.includes(i)) {
              selectedSeatIndices = selectedSeatIndices.filter(item => item !== i);
              seat.classList.remove('seat-selected');
              seat.classList.add('bg-slate-700');
            } else {
              selectedSeatIndices.push(i);
              seat.classList.remove('bg-slate-700');
              seat.classList.add('seat-selected');
            }
            updateTotals();
          };
        }
        container.appendChild(seat);
      }
    }

    function updateTotals() {
      const moviePrice = Number(document.getElementById('movieSelect').value);
      const count = selectedSeatIndices.length;
      document.getElementById('count').innerText = count;
      document.getElementById('total').innerText = (count * moviePrice).toLocaleString('vi-VN') + ' VNĐ';
    }

    document.getElementById('movieSelect').addEventListener('change', updateTotals);

    function openCheckoutModal() {
      if (selectedSeatIndices.length === 0) {
        alert('⚠️ Vui lòng click chọn ít nhất 1 ghế trên sơ đồ trước khi đặt vé!');
        return;
      }
      const select = document.getElementById('movieSelect');
      const movieTitle = select.options[select.selectedIndex].getAttribute('data-title');
      const showtime = document.getElementById('showtimeSelect').value;
      const moviePrice = Number(select.value);

      const seatNames = selectedSeatIndices.map(i => {
        const rowChar = String.fromCharCode(65 + Math.floor(i / COLS));
        const colNum = (i % COLS) + 1;
        return `${rowChar}${colNum}`;
      }).join(', ');

      document.getElementById('modalMovie').innerText = movieTitle;
      document.getElementById('modalShowtime').innerText = showtime;
      document.getElementById('modalSeats').innerText = seatNames;
      document.getElementById('modalTotal').innerText = (selectedSeatIndices.length * moviePrice).toLocaleString('vi-VN') + ' VNĐ';

      document.getElementById('checkoutModal').classList.remove('hidden');
    }

    function closeCheckoutModal() {
      document.getElementById('checkoutModal').classList.add('hidden');
    }

    function confirmBooking() {
      const name = document.getElementById('custName').value.trim() || 'Khách vãng lai';
      const phone = document.getElementById('custPhone').value.trim() || 'Chưa cung cấp';
      const select = document.getElementById('movieSelect');
      const movieTitle = select.options[select.selectedIndex].getAttribute('data-title');
      const price = Number(select.value) * selectedSeatIndices.length;

      const seatNames = selectedSeatIndices.map(i => {
        const rowChar = String.fromCharCode(65 + Math.floor(i / COLS));
        const colNum = (i % COLS) + 1;
        return `${rowChar}${colNum}`;
      }).join(', ');

      const newBooking = {
        id: 'TKT-' + Math.floor(1000 + Math.random() * 9000),
        name: name,
        phone: phone,
        movie: movieTitle,
        seats: seatNames,
        amount: price.toLocaleString('vi-VN') + ' VNĐ'
      };

      let currentBookings = JSON.parse(localStorage.getItem('cinema_bookings') || '[]');
      currentBookings.push(newBooking);
      localStorage.setItem('cinema_bookings', JSON.stringify(currentBookings));

      // Đổi các ghế vừa chọn thành ghế đã bán
      selectedSeatIndices.forEach(idx => occupiedSeats.push(idx));

      closeCheckoutModal();
      alert(`🎉 ĐẶT VÉ THÀNH CÔNG!\n\n- Mã vé: ${newBooking.id}\n- Khách hàng: ${newBooking.name}\n- Phim: ${newBooking.movie}\n- Ghế: ${newBooking.seats}\n- Tổng tiền: ${newBooking.amount}`);
      initSeatMap();
    }

    function switchTab(tab) {
      if (tab === 'booking') {
        document.getElementById('bookingSection').classList.remove('hidden');
        document.getElementById('adminSection').classList.add('hidden');
      } else {
        document.getElementById('bookingSection').classList.add('hidden');
        document.getElementById('adminSection').classList.remove('hidden');
        updateAdminView();
      }
    }

    function updateAdminView() {
      const bookings = JSON.parse(localStorage.getItem('cinema_bookings') || '[]');
      document.getElementById('adminTickets').innerText = bookings.length;

      const totalRevenue = bookings.reduce((sum, item) => sum + parseInt(item.amount.replace(/[^0-9]/g, '')), 0);
      document.getElementById('adminRevenue').innerText = totalRevenue.toLocaleString('vi-VN') + ' VNĐ';

      const tbody = document.getElementById('adminTableBody');
      tbody.innerHTML = '';
      bookings.slice().reverse().forEach(b => {
        const row = `<tr class="border-t border-slate-800">
          <td class="p-3 font-mono text-red-400 font-bold">${b.id}</td>
          <td class="p-3">${b.name}</td>
          <td class="p-3 text-slate-400">${b.phone}</td>
          <td class="p-3">${b.movie}</td>
          <td class="p-3 text-emerald-400 font-semibold">${b.seats}</td>
          <td class="p-3 font-bold">${b.amount}</td>
        </tr>`;
        tbody.innerHTML += row;
      });
    }

    function clearAllData() {
      if (confirm('Bạn chắc chắn muốn xóa toàn bộ lịch sử vé đã đặt?')) {
        localStorage.removeItem('cinema_bookings');
        updateAdminView();
      }
    }

    // Luôn vẽ sơ đồ ghế ngay khi trang tải xong
    window.addEventListener('DOMContentLoaded', initSeatMap);
  </script>
</body>
</html>
